{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safety-stl.local/schema/stage2-v0-specification.json",
  "title": "Stage II v0 D37 controlled-language specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "canonical_natural_language",
    "paraphrases",
    "typed_ast",
    "gold_stl",
    "formula_family",
    "grounding_schema",
    "parameter_values",
    "semantic_pair_id",
    "contrast_group_id",
    "semantic_contrast_type",
    "allowed_online_use",
    "online_use_status",
    "split",
    "annotation_author",
    "independent_reviewer",
    "review_status",
    "source_or_generation_record"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^(br|rp|ba|and|or)-v0-[0-9]{3}$"
    },
    "canonical_natural_language": {"type": "string", "minLength": 20},
    "paraphrases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20}
    },
    "typed_ast": {"type": "object"},
    "gold_stl": {"type": "string", "minLength": 10},
    "formula_family": {
      "enum": [
        "hysteretic_bounded_recovery",
        "recovery_plus_persistence",
        "bounded_avoidance",
        "conjunction",
        "disjunction"
      ]
    },
    "grounding_schema": {"type": "object"},
    "parameter_values": {"type": "object"},
    "semantic_pair_id": {"type": "string"},
    "contrast_group_id": {"type": "string", "pattern": "^d37-index-[0-9]{3}$"},
    "semantic_contrast_type": {"type": "string"},
    "allowed_online_use": {"type": "boolean"},
    "online_use_status": {
      "enum": ["stage1_calibrated_online", "offline_only_pending_feasibility"]
    },
    "split": {"enum": ["train", "validation", "parameter_test", "structure_test"]},
    "annotation_author": {"type": "string", "minLength": 1},
    "independent_reviewer": {"type": ["string", "null"]},
    "review_status": {
      "enum": ["machine_validated_pending_independent_review", "independently_reviewed"]
    },
    "source_or_generation_record": {"type": "string"}
  }
}
